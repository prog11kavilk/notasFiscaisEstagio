    {
      "name": "3 - Notas fiscais  (tabelas nota_fiscal + itens)",
      "description": "Corpo: clienteCodigo + itens[{produtoCodigo, quantidade}]. O valor unitário é copiado do produto; o total é calculado.",
      "item": [
        {
          "name": "POST nota 1 - Ana: 2 teclados + 3 mouses",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 201', () => pm.response.to.have.status(201));",
                  "const j = pm.response.json();",
                  "pm.test('devolve numeroNota', () => pm.expect(j.numeroNota).to.be.a('number'));",
                  "pm.collectionVariables.set('nota1', j.numeroNota);",
                  "pm.test('total 391.00', () => pm.expect(j.valorTotal).to.eql(391.00));",
                  "pm.test('2 itens', () => pm.expect(j.itens.length).to.eql(2));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/nf/nota_fiscal/create",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "nf",
                "nota_fiscal",
                "create"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"clienteCodigo\": \"{{clienteAnaId}}\",\n  \"itens\": [\n    {\n      \"produtoCodigo\": \"{{produtoTecladoId}}\",\n      \"quantidade\": 2\n    },\n    {\n      \"produtoCodigo\": \"{{produtoMouseId}}\",\n      \"quantidade\": 3\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
