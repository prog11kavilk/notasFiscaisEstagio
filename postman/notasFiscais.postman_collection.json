    {
      "name": "5 - Conferência",
      "description": "",
      "item": [
        {
          "name": "GET nota 1 (3 linhas de item, soma 601.00)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const linhas = pm.response.json();",
                  "pm.test('3 linhas (uma por item)', () => pm.expect(linhas.length).to.eql(3));",
                  "pm.test('clienteNome Ana Souza em todas', () => pm.expect(linhas.every(l => l.clienteNome === 'Ana Souza')).to.be.true);",
                  "const soma = linhas.reduce((s, l) => s + l.valorTotal, 0);",
                  "pm.test('soma dos valorTotal = 601.00', () => pm.expect(Math.round(soma * 100)).to.eql(60100));",
                  "pm.test('colunas esperadas', () => pm.expect(Object.keys(linhas[0])).to.have.members(['numeroNota','codigoItem','clienteNome','produtoNome','valorUnitario','quantidade','valorTotal']));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/nf/nota_fiscal/{{nota1}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "nf",
                "nota_fiscal",
                "{{nota1}}"
              ]
            }
