{
  "info": {
    "name": "Notas Fiscais - roteiro de inserção",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Rode a coleção inteira na ordem (Runner). Ordem: clientes -> produtos -> notas -> itens -> conferência. Os codigos gerados são guardados em variáveis da coleção."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    }
  ],
  "item": [
    {
      "name": "1 - Clientes  (tabela clientes)",
      "description": "Corpo: nome e cpf (11 dígitos, único). Guarda o codigo em {{clienteXxxId}}.",
      "item": [
        {
          "name": "POST cliente - Ana Souza",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 201', () => pm.response.to.have.status(201));",
                  "const j = pm.response.json();",
                  "pm.test('devolve codigo', () => pm.expect(j.codigo).to.be.a('number'));",
                  "pm.collectionVariables.set('clienteAnaId', j.codigo);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/nf/clientes/create",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "nf",
                "clientes",
                "create"
              ]
            },
